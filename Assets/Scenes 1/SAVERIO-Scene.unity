  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ainsi\u2026 tu choisis d\u2019avancer sans d\xE9tour. Je te croyais prudente,
    mais je me suis tromp\xE9. Ce visage, c\u2019est celui de la v\xE9rit\xE9. Et
    il est temps, oui\u2026 que le Chat la re\xE7oive. M\xEAme si elle le blesse."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
