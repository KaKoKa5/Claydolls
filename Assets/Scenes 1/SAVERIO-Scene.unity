      m_Calls: []
  m_text: "Oh non\u2026 Pas toi encore. Tu crois que j\u2019ai l\u2019temps d\u2019causer
    avec la premi\xE8re cagoul\xE9e venue ? J\u2019te dois rien, et j\u2019te dirai
    rien. Tire toi. J\u2019ai pas l\u2019envie d\u2019\xEAtre charitable aujourd\u2019hui."
  m_isRightToLeft: 0
