  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " Oh\u2026 voil\xE0 un visage que je ne connais point. Ou plut\xF4t\u2026
    un masque. Tu es bien fra\xEEche encore\u2026 \xE7a se voit \xE0 ta mani\xE8re
    de marcher. Trop droite, trop vive. Moi, l\u2019on m\u2019appelle le Serpent.
    Mais ne t\u2019effraie pas\u2026 Je ne mords que si l\u2019on me ment. Nous finirons
    par nous reparler, toi et moi. Quand tu auras\u2026 des choses \xE0 offrir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
