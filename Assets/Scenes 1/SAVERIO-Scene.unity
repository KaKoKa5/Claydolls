  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "J-je\u2026 je sais rien de grave ! J\u2019ai juste vu le Cochon\u2026
    euh\u2026 il change souvent les serrures de la grange ! Peut-\xEAtre qu\u2019il
    aime les cadenas ? Hein ? Il parle beaucoup tout seul aussi\u2026 Euh... Le serpent
    chante toute seule pendant la nuit ! C\u2019est tout ce que je sais ! Je vous
    jure !"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
