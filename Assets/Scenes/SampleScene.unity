--- !u!114 &887828338
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 887828336}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "\u2026Voil\xE0 un masque qu\u2019on ne porte pas \xE0 la l\xE9g\xE8re. Je
    voudrais\u2026 que le Corbeau sache. Je ne l\u2019ai jamais abandonn\xE9. Elle
    peut partir, maintenant, c\u2019est ce que je veux pour elle. Je ne sortirai
    pas. La mal\xE9diction me gagne\u2026 Je le sens. Bient\xF4t, je ne serai plus
    qu\u2019une statue de silence. La cl\xE9\u2026 de la libert\xE9\u2026 est dans
    le masque fendu en deux. Celui qui d\xE9tient la v\xE9rit\xE9. Il est en s\xE9curit\xE9
    chez moi Va voir le Corb...."
  TMPROui: {fileID: 0}
  Count: 0
