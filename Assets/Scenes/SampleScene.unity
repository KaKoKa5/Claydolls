  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Notre fille, le Ph\xE9nix, a trouv\xE9 le seul moyen de briser la mal\xE9diction
    et de nous lib\xE9rer. Elle s'est d\xE9barrass\xE9 du sortil\xE8ge de son masque.
    Malheureusement elle fut expuls\xE9e de Claydolls sans possibilit\xE9 de retour.
    Et nous\u2026 nous n\u2019avons plus jamais pu la revoir."
  TMPROui: {fileID: 0}
  Count: -122
