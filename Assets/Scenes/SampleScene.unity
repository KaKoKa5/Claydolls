  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tu ne m\u2019inspires gu\xE8re confiance\u2026 mais je ne suis point un
    rustre. On me nommait jadis le Chien, dans un autre royaume. J\u2019\xE9tais
    garde, loyal jusqu\u2019au dernier souffle. Aujourd\u2019hui, je veille. Sur
    ce lieu. Sur lui. C\u2019est tout ce que tu dois savoir\u2026 pour l\u2019instant."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
