  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Tu ne m\u2019inspires gu\xE8re confiance\u2026 mais je ne suis point un
    rustre. On me nomme le Chien. Dans un autre royaume, j\u2019\xE9tais garde, loyal
    jusqu\u2019au dernier souffle. Aujourd\u2019hui, je veille. Sur ce lieu. Sur
    lui. C\u2019est tout ce que tu dois savoir\u2026 pour l\u2019instant."
  TMPROui: {fileID: 0}
  Count: 0
