MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1032233306}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "C\u2019est un masque qui fait taire les faibles\u2026 et fait douter les
    plus forts. Mais je ne vois pas une b\xEAte en toi. J\u2019vois quelqu\u2019un
    qui sait jusqu\u2019o\xF9 il peut aller\u2026 sans s\u2019y perdre. Si c\u2019est
    \xE7a que tu choisis de montrer, alors je l\u2019accepte. M\xEAme si je pr\xE9f\xE8re
    quand tu ne montre pas les crocs."
  TMPROui: {fileID: 0}
  Count: 0
