  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Le Cerf\u2026Il fut fermier, jadis. Un jour de march\xE9, il tua sans le
    vouloir un seigneur querelleur. Un coup de trop, un cri, une chute. La justice
    royale ne pardonne pas l\u2019accident quand le sang est bleu. Il s\u2019est
    enfui. Et Claydolls l\u2019a gard\xE9."
  TMPROui: {fileID: 0}
  Count: 0
