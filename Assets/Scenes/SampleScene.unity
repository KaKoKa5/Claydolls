      m_Calls: []
  m_text: "C\u2019est doux \xE0 voir\u2026 La lumi\xE8re que tu s\xE8mes l\xE0 o\xF9
    d\u2019autres n\u2019osaient plus marcher. Le Chien a lev\xE9 la t\xEAte. Voil\xE0
    qui m\u2019\xE9meut. Tu m\xE9rites une v\xE9rit\xE9. Peut-\xEAtre qu\u2019elle
    t\u2019aidera, ou peut-\xEAtre non."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
