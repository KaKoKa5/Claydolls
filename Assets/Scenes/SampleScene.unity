MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1164657060}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: " Oh\u2026 voil\xE0 un visage que je ne connais point. Ou plut\xF4t\u2026
    un masque. Tu es bien fra\xEEche encore\u2026 \xE7a se voit \xE0 ta mani\xE8re
    de marcher. Trop droite, trop vive. Moi, l\u2019on m\u2019appelle le Serpent.
    Mais ne t\u2019effraie pas\u2026 Je ne mords que si l\u2019on me ment. Nous finirons
    par nous reparler, toi et moi. Quand tu auras\u2026 des choses \xE0 offrir."
  TMPROui: {fileID: 0}
  Count: 0
