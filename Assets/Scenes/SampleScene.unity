  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Ah, te voil\xE0\u2026 Et je vois que tu portes un nouveau visage. Tu t\u2019adaptes.
    C\u2019est bien. Ce village ne r\xE9pond qu\u2019\xE0 ceux qui savent changer
    de peau sans perdre leur c\u0153ur. Continue ainsi, Peau d\u2019\xC2ne. Tu fais
    les pas que d\u2019autres n\u2019osent plus faire."
  TMPROui: {fileID: 0}
  Count: 0
