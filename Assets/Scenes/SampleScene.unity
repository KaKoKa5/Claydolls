  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Tu l\u2019as fait. Sans force, sans cris\u2026 juste en cherchant la v\xE9rit\xE9.
    Ce n\u2019est pas donn\xE9 \xE0 tout le monde. Alors je te le dis simplement
    : bravo."
  TMPROui: {fileID: 0}
  Count: 0
