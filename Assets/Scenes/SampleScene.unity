--- !u!114 &1022433755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1022433751}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Tu erres, petite \xE2me\u2026 Mais que cherches-tu vraiment ? Une sortie
    ? Un sens ? Ou juste un peu de v\xE9rit\xE9 ? Je n\u2019offre point mes secrets
    \xE0 la premi\xE8re venue. Il te faudra me montrer que ton c\u0153ur est digne
    de les porter. Reviens me voir\u2026 lorsque tu auras tendu la main \xE0 l\u2019un
    des n\xF4tres. Un seul. Mais sinc\xE8rement. Alors, peut-\xEAtre, j\u2019ouvrirai
    mes ailes. "
  TMPROui: {fileID: 0}
  Count: 0
