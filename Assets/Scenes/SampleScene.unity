      m_Calls: []
  m_text: "Le Cerf\u2026 Un criminel. Cela explique sa prudence quant \xE0 l'\xE9vocation
    de son pass\xE9. Voil\xE0 un bon troc. Alors \xE9coute."
  m_isRightToLeft: 0
