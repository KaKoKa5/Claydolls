  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oh\u2026 Sa Majest\xE9 en personne. Quelle allure, quelle prestance\u2026Haha...
    Mais dis-moi, Peau d\u2019\xC2ne, est-ce donc la crini\xE8re qui t\u2019\xE9touffe
    ? Tu marches comme si chaque pas pesait une tonne. Allons, ne te froisse pas.
    J\u2019admire l\u2019effort. Mais ce masque-l\xE0\u2026 il gronde plus qu\u2019il
    ne mord."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
