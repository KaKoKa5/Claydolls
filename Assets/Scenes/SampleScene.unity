  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d56ef366ee3c947a096ea18725a5d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "Alors\u2026 c\u2019\xE9tait lui. Le Cochon. Je le craignais\u2026 mais maintenant
    je le sais. Tu as fait ce que moi je n\u2019ai jamais eu la force de faire. Merci,
    Peau d\u2019\xC2ne. Le Hibou est l\xE0, quelque part, sous cette maison\u2026
    cherche un passage. Cherche un acc\xE8s autour de la maison, mon sous sol contient
    une cave avec un fen\xEAtre menant vers l'ext\xE9rieur, c'est peut \xEAtre aussi
    son cas..."
  TMPROui: {fileID: 0}
  Count: 0
